# Local test environment. Do not put production Bunny/R2/payment secrets here.
APP_ENV=local
API_HOST=127.0.0.1
API_PORT=18110

POSTGRES_USER=minitv
POSTGRES_PASSWORD=minitv_local
POSTGRES_DB=minitv
POSTGRES_PORT=15432
DATABASE_URL=postgresql://minitv:minitv_local@127.0.0.1:15432/minitv

REDIS_PASSWORD=minitv_local
REDIS_PORT=16379
REDIS_URL=redis://:minitv_local@127.0.0.1:16379/0

ANDROID_SDK_ROOT=/opt/homebrew/share/android-commandlinetools
ANDROID_HOME=/opt/homebrew/share/android-commandlinetools

# Dev-only Bunny credentials. Must be a separate Library / Storage Zone from production.
# Account-level API key (resource management only). Values below are filled after
# creating the dev resource set (see docs/technical-architecture.md section 4).
# BUNNY_MODE: fake (default, offline stubs) or real (call Bunny APIs).
BUNNY_MODE=fake
BUNNY_API_KEY=

BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_HOST=
BUNNY_STORAGE_PASSWORD=
BUNNY_STORAGE_READONLY_PASSWORD=
BUNNY_IMAGE_PULL_ZONE_ID=
BUNNY_IMAGE_CDN_HOST=
BUNNY_IMAGE_TOKEN_KEY=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_READONLY_API_KEY=
BUNNY_STREAM_PULL_ZONE_ID=
BUNNY_STREAM_CDN_HOST=
BUNNY_STREAM_TOKEN_KEY=

# --- Domain: minitv.us (Cloudflare zone) ---
# Apex + www are served by the Cloudflare R2 bucket (R2 custom domains, proxied).
# These are public identifiers, safe to commit. Do not add R2 write keys here.
SITE_DOMAIN=minitv.us
SITE_URL=https://minitv.us
WWW_URL=https://www.minitv.us
# 域名路由（2026-10-14 已配置）:
#   minitv.us / www.minitv.us -> R2 前端网页（官网静态页，桶根目录）
#   admin.minitv.us          -> R2 管理系统（CMS 静态页，发布在桶内 /admin/ 前缀）
#   api.minitv.us            -> 接口服务（服务器 YOUR_SERVER_IP，Cloudflare 代理）
API_BASE_URL=https://api.minitv.us
ADMIN_URL=https://admin.minitv.us
API_SERVER_IP=YOUR_SERVER_IP

# --- Cloudflare R2 frontend bucket (minitv-web, Location ENAM) ---
# Static frontends only (official site + CMS HTML). Release layout: releases/{version}/.
# R2 Access Key / Secret live in CI secrets only, never in this file.
R2_ACCOUNT_ID=YOUR_ACCOUNT_ID
R2_BUCKET=minitv-web
R2_S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://minitv.us

# Resend sends every product email, including verification codes.
# The key lives only in the local .env / server secrets, never here.
# RESEND_FROM must be on a domain verified in that Resend account.
RESEND_API_KEY=
RESEND_FROM=

# Google Sign-In. The client ID is public; the login API verifies the ID token
# audience against it. A verified Google email merges into the existing user.
GOOGLE_CLIENT_ID=

# Facebook Login. The App ID is public (H5 SDK + native SDKs read it from
# /v1/auth/providers); the secret never leaves the server and is only used to
# call debug_token. Leave both empty to hide the Facebook button everywhere.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# A Facebook sign-in lands on the account that already owns the confirmed email.
# Set to 0 to keep such sign-ins in a separate account instead.
FACEBOOK_LINK_BY_EMAIL=1

# OpenAI 自动审核（后台「自动审核」页配置模型、提示词与阈值）。
# 密钥优先取后台页面保存的加密副本，未配置时回退到这里的 OPENAI_API_KEY。
# MODERATION_KEY_SECRET 是加密密钥的主密钥，生产必须设置且不要随意更换
# （更换后后台保存的旧密钥无法解密，会退回 OPENAI_API_KEY）。
# 未配置任何密钥时评论保持「待审核」，不影响发评论。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://codex.apiz.ai/v1
MODERATION_KEY_SECRET=
