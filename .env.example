# Local test environment. Do not put production Bunny/R2/payment secrets here.
APP_ENV=local
API_HOST=127.0.0.1
API_PORT=18110

POSTGRES_USER=minitv
POSTGRES_PASSWORD=minitv_local
POSTGRES_DB=minitv
POSTGRES_PORT=15432
DATABASE_URL=postgresql://minitv:minitv_local@127.0.0.1:15432/minitv

REDIS_PASSWORD=minitv_local
REDIS_PORT=16379
REDIS_URL=redis://:minitv_local@127.0.0.1:16379/0

ANDROID_SDK_ROOT=/opt/homebrew/share/android-commandlinetools
ANDROID_HOME=/opt/homebrew/share/android-commandlinetools

# Dev-only Bunny credentials. Must be a separate Library / Storage Zone from production.
BUNNY_API_KEY=
