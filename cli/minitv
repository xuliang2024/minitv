# output
# ---------------------------------------------------------------------------


def _is_json(args) -> bool:
    return bool(getattr(args, "json", False)) or not sys.stdout.isatty()


def _fields(args):
    raw = getattr(args, "fields", None)
    return [part.strip() for part in raw.split(",") if part.strip()] if raw else None


def _filter(data, fields):
    if not fields:
        return data
    if isinstance(data, list):
        return [{k: item.get(k) for k in fields if k in item} for item in data]
    if isinstance(data, dict):
        return {k: data[k] for k in fields if k in data}
    return data


def _width(text):
    return sum(2 if unicodedata.east_asian_width(ch) in "WF" else 1 for ch in text)


def _pad(text, width):
    return text + " " * max(0, width - _width(text))


def _cell(value):
    if value is None:
        return "-"
    if isinstance(value, str) and len(value) >= 19 and value[4] == "-" and value[10] == "T":
        try:
            moment = datetime.fromisoformat(value.replace("Z", "+00:00"))
            return moment.astimezone().strftime("%Y-%m-%d %H:%M")
        except ValueError:
            pass
    if isinstance(value, bool):
        return "yes" if value else "no"
    if isinstance(value, (list, tuple)):
        if value and isinstance(value[0], dict) and "name_en" in value[0]:
            return ", ".join(str(item.get("name_en")) for item in value) or "-"
        return ", ".join(str(item) for item in value) or "-"
    if isinstance(value, dict):
        return json.dumps(value, ensure_ascii=False)
    return str(value)


def print_table(rows, columns, footer=None):
    headers = [title for title, _ in columns]
    table = [[_cell(row.get(key)) for _, key in columns] for row in rows]
    widths = [max([_width(headers[i])] + [_width(line[i]) for line in table]) for i in range(len(columns))]
    print("  ".join(_pad(headers[i], widths[i]) for i in range(len(columns))))
    for line in table:
        print("  ".join(_pad(line[i], widths[i]) for i in range(len(columns))))
    if footer:
        print(footer)


def print_kv(pairs):
    width = max([_width(str(label)) for label, _ in pairs] + [4])
    for label, value in pairs:
        print(f"{_pad(str(label), width)}  {_cell(value)}")


def output(args, payload, *, rows=None, columns=None, footer=None, quiet_key=None):
    fields = _fields(args)
    # --quiet outranks --json: pipelines want ids, not an envelope.
    if getattr(args, "quiet", False) and rows is not None and quiet_key:
        for row in rows:
            print(row.get(quiet_key))
        return
    if _is_json(args):
        data = payload
        if fields:
            if isinstance(payload, dict) and isinstance(payload.get("items"), list):
                # Trim list rows, keep total/page intact.
                data = dict(payload)
                data["items"] = [_filter(row, fields) for row in payload["items"]]
            else:
                data = _filter(payload, fields)
        print(json.dumps({"ok": True, "data": data, "meta": {"version": VERSION}}, ensure_ascii=False))
        return
    if rows is not None and columns:
        print_table(rows, columns, footer=footer)
        return
    if isinstance(payload, dict):
        pairs = [(k, v) for k, v in payload.items() if fields is None or k in fields]
        print_kv(pairs)
    else:
        print(json.dumps(payload, ensure_ascii=False, indent=2))


