def render_command_help(group, entry):
    lines = [
        f"minitv {group['name']} {entry['name']} — {entry['summary']}",
        "",
        "用途",
        f"  {entry['summary']}",
        "",
        "用法",
        f"  {entry['usage']}",
        "",
        "参数",
    ]
    all_args = list(entry["args"]) + GLOBAL_ARGS
    if all_args:
        flag_width = max(_width(", ".join(a["flags"])) for a in all_args) + 2
        for item in all_args:
            if item.get("kind") == "positional":
                flags = f"<{item['flags'][0]}>"
            else:
                flags = ", ".join(item["flags"])
            if item.get("kind") == "int":
                flags += f" {item.get('metavar') or 'N'}"
            elif item.get("kind") in ("str", "choice") and item.get("metavar"):
                flags += f" {item['metavar']}"
            tag = "必填" if item.get("required") else "可选"
            default = f"，默认 {item['default']}" if item.get("default") not in (None, False) else ""
            choices = f"，可选 {', '.join(item['choices'])}" if item.get("choices") else ""
            lines.append(f"  {_pad(flags, flag_width)}  {tag}  {item['help']}{choices}{default}")
    else:
        lines.append("  （无参数）")
    lines += ["", "示例"]
    for example in entry["examples"]:
        lines.append(f"  {example}")
    lines += [
        "",
        "输出",
        f"  {entry['outputs'] or '见 --json'}",
        "",
        "退出码",
        f"  {entry['exits'] or GLOBAL_EXITS}",
    ]
    if entry["errors"]:
        lines += ["", "常见错误"]
        for code, meaning in entry["errors"]:
            lines.append(f"  {code:<20}{meaning}")
    if entry["next_steps"]:
        lines += ["", "相关命令"]
        for step in entry["next_steps"]:
            lines.append(f"  {step}")
    print("\n".join(lines))
    return EXIT_OK


