VERSION = "0.1.0"
DEFAULT_BASE = "https://api.minitv.us"
# Cloudflare blocks urllib's default UA, so every request carries this one.
UA = f"minitv/{VERSION} (+https://minitv.us)"

EXIT_OK = 0
EXIT_ERROR = 1
EXIT_USAGE = 2
EXIT_AUTH = 3
EXIT_NOT_FOUND = 4
EXIT_CONFLICT = 5
EXIT_UPLOAD = 6
EXIT_NETWORK = 7

EXIT_TABLE = [
    ("0", "成功"),
    ("2", "用法错误"),
    ("3", "认证 / 权限（过期、撤销、账号禁用、scope 不足）"),
    ("4", "对象不存在"),
    ("5", "状态冲突（重复、非法迁移、限流）"),
    ("6", "上传失败"),
    ("7", "网络错误"),
]


# ---------------------------------------------------------------------------
# errors
# ---------------------------------------------------------------------------


class CliError(Exception):
    def __init__(self, message, *, code="error", exit_code=EXIT_ERROR, hint=None):
        self.message = message
        self.code = code
        self.exit_code = exit_code
        self.hint = hint
        super().__init__(message)


def usage_error(message, hint=None):
    return CliError(message, code="usage", exit_code=EXIT_USAGE, hint=hint)


