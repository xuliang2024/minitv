#!/usr/bin/env python3
"""minitv - MiniTV 剧集管理命令行。

单文件、零第三方依赖（Python >= 3.8）。设计见 docs/cli-execution-plan.md：
- help 由 SPEC 同源生成，`--help` / `help --json` / `guide` 三处永远一致；
- 所有命令在 TTY 下打表格，非 TTY 或 --json 时输出 {"ok":true,"data":...}；
- 密钥只从环境变量或 0600 凭据文件读，命令行参数传 key 会被拒绝。

给 Agent：先跑 `minitv guide` 取完整手册，按每条命令 help 里的「相关命令」串流程。
"""

from __future__ import annotations

import argparse
import base64
import json
import os
import re
import secrets
import sys
import time
import unicodedata
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

VERSION = "0.3.1"
DEFAULT_BASE = "https://api.minitv.us"
# Cloudflare blocks urllib's default UA, so every request carries this one.
UA = f"minitv/{VERSION} (+https://minitv.us)"

EXIT_OK = 0
EXIT_ERROR = 1
EXIT_USAGE = 2
EXIT_AUTH = 3
EXIT_NOT_FOUND = 4
EXIT_CONFLICT = 5
EXIT_UPLOAD = 6
EXIT_NETWORK = 7

EXIT_TABLE = [
    ("0", "成功"),
    ("2", "用法错误"),
    ("3", "认证 / 权限（过期、撤销、账号禁用、scope 不足）"),
    ("4", "对象不存在"),
    ("5", "状态冲突（重复、非法迁移、限流）"),
    ("6", "上传失败"),
    ("7", "网络错误"),
]


# ---------------------------------------------------------------------------
# errors
# ---------------------------------------------------------------------------


class CliError(Exception):
    def __init__(self, message, *, code="error", exit_code=EXIT_ERROR, hint=None, detail=None):
        self.message = message
        self.code = code
        self.exit_code = exit_code
        self.hint = hint
        # Structured ``detail`` from the API (e.g. {"drama_id": 7} on a 409).
        self.detail = detail if isinstance(detail, dict) else None
        super().__init__(message)


def usage_error(message, hint=None):
    return CliError(message, code="usage", exit_code=EXIT_USAGE, hint=hint)


