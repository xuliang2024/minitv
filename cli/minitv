def arg(flags, help_text, *, kind="str", choices=None, default=None, metavar=None, required=False):
    return {
        "flags": flags,
        "help": help_text,
        "kind": kind,
        "choices": choices,
        "default": default,
        "metavar": metavar,
        "required": required,
    }


def pos(name, help_text):
    """位置参数（<id> 这类）；flags 里只有名字，没有前导 --。"""
    return {
        "flags": [name],
        "help": help_text,
        "kind": "positional",
        "choices": None,
        "default": None,
        "metavar": name,
        "required": True,
    }


def cmd(name, summary, usage, fn, *, args=(), examples=(), outputs="", exits="", errors=(), next_steps=()):
    return {
        "name": name,
        "summary": summary,
        "usage": usage,
        "fn": fn,
        "args": list(args),
        "examples": list(examples),
        "outputs": outputs,
        "exits": exits,
        "errors": list(errors),
        "next_steps": list(next_steps),
    }


