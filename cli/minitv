def build_parser():
    parents = argparse.ArgumentParser(add_help=False)
    # SUPPRESS: a subparser must not reset a global flag given before the
    # subcommand (`minitv --json drama list`).
    parents.add_argument("--json", action="store_true", default=argparse.SUPPRESS, help="结构化输出")
    parents.add_argument("--quiet", action="store_true", default=argparse.SUPPRESS, help="只输出 id")
    parents.add_argument("--fields", default=argparse.SUPPRESS, help="裁剪字段")
    parents.add_argument("--profile", default=argparse.SUPPRESS, help="profile 名")
    parents.add_argument("--base-url", dest="base_url", default=argparse.SUPPRESS, help="覆盖 base_url")
    parents.add_argument("--timeout", type=int, default=argparse.SUPPRESS, help="HTTP 超时秒数")

    parser = argparse.ArgumentParser(prog="minitv", add_help=False, parents=[parents])
    subparsers = parser.add_subparsers(dest="group")

    for group in SPEC:
        group_parser = subparsers.add_parser(group["name"], add_help=False, parents=[parents])
        if group["name"] == "doctor":
            # `minitv doctor` has no subcommand; bind the handler to the group.
            group_parser.set_defaults(func=group["commands"][0]["fn"])
            continue
        command_parsers = group_parser.add_subparsers(dest="command")
        for entry in group["commands"]:
            command_parser = command_parsers.add_parser(entry["name"], add_help=False, parents=[parents])
            command_parser.set_defaults(func=entry["fn"])
            for item in entry["args"]:
                flags = item["flags"]
                kwargs = {"help": item["help"]}
                if item.get("kind") == "positional":
                    command_parser.add_argument(item["flags"][0], help=item["help"])
                    continue
                if item.get("kind") == "bool":
                    command_parser.add_argument(*flags, action="store_true", **kwargs)
                else:
                    if item.get("choices"):
                        kwargs["choices"] = item["choices"]
                    if item.get("kind") == "int":
                        kwargs["type"] = int
                    if item.get("default") is not None:
                        kwargs["default"] = item["default"]
                    if item.get("metavar"):
                        kwargs["metavar"] = item["metavar"]
                    command_parser.add_argument(*flags, **kwargs)
    return parser


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)

    if argv and argv[0] in ("-v", "--version", "version"):
        print(VERSION)
        return EXIT_OK
    if not argv or argv[0] in ("-h", "--help"):
        return render_top_help()
    if argv[0] == "guide":
        fmt = argv[argv.index("--format") + 1] if "--format" in argv and argv.index("--format") + 1 < len(argv) else "md"
        if fmt == "json":
            print(json.dumps(catalog(), ensure_ascii=False, indent=2))
        else:
            sys.stdout.write(render_guide())
        return EXIT_OK
    if argv[0] == "help":
        rest = [item for item in argv[1:] if not item.startswith("-")]
        if "--json" in argv:
            print(json.dumps(catalog(), ensure_ascii=False, indent=2))
            return EXIT_OK
        if rest and rest[0] in TOPICS:
            print("\n".join(TOPICS[rest[0]]))
            return EXIT_OK
        if rest:
            return render_help(rest)
        return render_top_help()
    if "-h" in argv or "--help" in argv:
        return render_help([item for item in argv if not item.startswith("-")][:2])

    parser = build_parser()
    try:
        args = parser.parse_args(argv)
    except SystemExit as exc:  # argparse already printed its own message
        return EXIT_USAGE if exc.code else EXIT_OK
    if not hasattr(args, "func"):
        return render_top_help()
    try:
        return args.func(args)
    except CliError as exc:
        _report_error(exc, args)
        return exc.exit_code
    except KeyboardInterrupt:
        return 130


def _report_error(exc, args):
    if _is_json(args):
        print(
            json.dumps(
                {"ok": False, "error": {"code": exc.code, "message": exc.message, "hint": exc.hint}},
                ensure_ascii=False,
            )
        )
        return
    print(f"[err] {exc.message}", file=sys.stderr)
    if exc.hint:
        print(f"      提示：{exc.hint}", file=sys.stderr)
    print(f"      退出码 {exc.exit_code}", file=sys.stderr)


if __name__ == "__main__":
    sys.exit(main())
