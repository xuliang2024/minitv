_PUBLISH_HOP = {"draft": "in_review", "in_review": "published", "unpublished": "published"}


def cmd_drama_publish(args):
    client = Client(resolve_settings(args))
    drama = _fetch_drama(client, args.id)
    hops = []
    while drama.get("status") != "published":
        current = drama.get("status")
        nxt = _PUBLISH_HOP.get(current)
        if nxt is None:
            raise CliError(f"当前状态 {current} 无法上线", code="conflict", exit_code=EXIT_CONFLICT)
        hops.append(f"{current} → {nxt}")
        payload = _write(args, client, "POST", f"/admin/v1/dramas/{args.id}/status", {"to_status": nxt})
        if payload is None:
            return EXIT_OK
        drama = _fetch_drama(client, args.id)
    if _is_json(args):
        output(args, {"id": int(args.id), "status": "published", "hops": hops})
    else:
        print(f"已上线 {args.id}（{'，'.join(hops) if hops else '本来就是 published'}）")
    return EXIT_OK


