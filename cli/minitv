def _read_key(args):
    if getattr(args, "stdin", False) or not sys.stdin.isatty():
        return sys.stdin.read().strip()
    import getpass

    return getpass.getpass("粘贴 API Key（输入不回显）：").strip()


def _identity(client):
    me = client.request("GET", "/admin/v1/auth/me") or {}
    scopes, expires = [], None
    try:
        listing = client.request("GET", "/admin/v1/auth/keys") or {}
        prefix = client.settings.api_key[:16]
        for row in listing.get("items") or []:
            if row.get("key_prefix") == prefix:
                scopes = row.get("scopes") or []
                expires = row.get("expires_at")
                break
    except CliError:
        pass
    return me, scopes, expires


def _warnings(me, scopes):
    notes = []
    if me.get("role") == "admin" and "delete" in (scopes or []):
        notes.append("该密钥绑定 admin 且含 delete，等同超管；给自动化用建议换 agent-ops")
    elif "delete" in (scopes or []):
        notes.append("该密钥含 delete，可删除剧集")
    return notes


def cmd_config_set_key(args):
    settings = resolve_settings(args, require_key=False)
    key = _read_key(args)
    if not key:
        raise usage_error("没有读到 API Key", hint="用 --stdin 传入，或直接在终端里运行")
    if not key.startswith("mk_live_"):
        raise usage_error("API Key 格式不对（应以 mk_live_ 开头）", hint="到后台「API 密钥」页重新复制")
    settings.api_key = key
    client = Client(settings)
    me, scopes, expires = _identity(client)

    # Persist the endpoint alongside the key. Without this, `set-key
    # --profile X --base-url ...` would only store the credential and every
    # later command on X would silently fall back to the default (production)
    # base_url — exactly the kind of mix-up that leaks a staging key upstream.
    cfg = load_config()
    prof = cfg["profiles"].setdefault(settings.profile, {"sandbox_drama_id": 0})
    if getattr(args, "base_url", None) or not prof.get("base_url"):
        prof["base_url"] = settings.base_url
    save_config(cfg)

    creds = load_credentials()
    creds[settings.profile] = key
    save_credentials(creds)

    payload = {
        "profile": settings.profile,
        "base_url": settings.base_url,
        "username": me.get("username"),
        "role": me.get("role"),
        "scopes": scopes,
        "expires_at": expires,
        "saved_to": str(credentials_path()),
        "warnings": _warnings(me, scopes),
    }
    if _is_json(args):
        output(args, payload)
        return EXIT_OK
    print_kv(
        [
            ("环境", f"{settings.profile} · {settings.base_url}"),
            ("身份", f"{me.get('username')}（{me.get('role')}）"),
            ("权限", " · ".join(scopes) if scopes else "跟随账号角色"),
            ("到期", expires or "长期"),
            ("已保存", f"{credentials_path()}（0600）"),
        ]
    )
    for note in payload["warnings"]:
        print(f"[提醒] {note}")
    print("下一步  minitv doctor")
    return EXIT_OK


