def _mime_for(path: Path) -> str:
    return "video/quicktime" if path.suffix.lower() == ".mov" else "video/mp4"


def _upload_one(args, client, episode_id, path: Path):
    size = path.stat().st_size
    if size > 200 * 1024 * 1024:
        raise usage_error(f"{path.name} 超过 200MB")
    if getattr(args, "dry_run", False):
        print(f"将上传 {path.name}（{size} 字节）→ 分集 {episode_id}")
        return {"status": "dry-run"}
    body = {
        "filename": path.name,
        "mime": _mime_for(path),
        "size_bytes": size,
        "width": 0,
        "height": 0,
        "duration_seconds": 0,
    }
    resume = bool(getattr(args, "resume", False))
    session = None
    if resume:
        try:
            session = client.request("POST", f"/admin/v1/episodes/{episode_id}/upload-headers")
        except CliError:
            session = None  # nothing in flight → start a fresh upload below
    if session is None:
        try:
            session = client.request(
                "POST", f"/admin/v1/episodes/{episode_id}/upload-session", body=body
            )
        except CliError as exc:
            if "in progress" in (exc.message or ""):
                raise CliError(
                    exc.message,
                    code=exc.code,
                    exit_code=exc.exit_code,
                    hint="该集正在上传；加 --resume 从断点续传",
                ) from exc
            raise
    started = time.time()
    transfer = client.tus_upload(session, path, resume=resume)
    elapsed = time.time() - started
    state = client.request("POST", f"/admin/v1/episodes/{episode_id}/sync-status") or {}
    return {
        "status": state.get("status"),
        "seconds": round(elapsed, 1),
        "size": size,
        "resumed": bool(transfer.get("resumed")),
    }


