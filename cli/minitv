def render_help(argv):
    argv = [item for item in argv if not item.startswith("-")]
    if not argv:
        return render_top_help()
    group = _find(argv[0])
    if group is None:
        print(f"未知命令：{argv[0]}", file=sys.stderr)
        render_top_help()
        return EXIT_USAGE
    if len(argv) == 1:
        if len(group["commands"]) == 1 and group["commands"][0]["name"] == group["name"]:
            return render_command_help(group, group["commands"][0])
        return render_group_help(group)
    entry = _find(argv[0], argv[1])
    if entry is None:
        print(f"未知命令：{argv[0]} {argv[1]}", file=sys.stderr)
        return render_group_help(group)
    return render_command_help(group, entry)


