def arg(flags, help_text, *, kind="str", choices=None, default=None, metavar=None, required=False):
    return {
        "flags": flags,
        "help": help_text,
        "kind": kind,
        "choices": choices,
        "default": default,
        "metavar": metavar,
        "required": required,
    }


def pos(name, help_text):
    """位置参数（<id> 这类）；flags 里只有名字，没有前导 --。"""
    return {
        "flags": [name],
        "help": help_text,
        "kind": "positional",
        "choices": None,
        "default": None,
        "metavar": name,
        "required": True,
    }


def cmd(name, summary, usage, fn, *, args=(), examples=(), outputs="", exits="", errors=(), next_steps=(), with_globals=True):
    return {
        "name": name,
        "summary": summary,
        "usage": usage,
        "fn": fn,
        "args": list(args),
        "examples": list(examples),
        "outputs": outputs,
        "exits": exits,
        "errors": list(errors),
        "next_steps": list(next_steps),
        "with_globals": with_globals,
    }


JSON_FLAG = arg(["--json"], "结构化输出（非 TTY 自动启用）", kind="bool")
QUIET_FLAG = arg(["--quiet"], "只输出 id，便于脚本串联", kind="bool")
FIELDS_FLAG = arg(["--fields"], "裁剪输出字段，如 id,title", metavar="LIST")
PROFILE_ARG = arg(["--profile"], "profile 名，默认取 default_profile", metavar="P")
BASE_ARG = arg(["--base-url"], "覆盖 base_url", metavar="URL")
TIMEOUT_ARG = arg(["--timeout"], "HTTP 超时秒数", kind="int", default=20, metavar="N")
DRY_RUN_ARG = arg(["--dry-run"], "只打印将要发送的请求，不执行", kind="bool")

GLOBAL_ARGS = [JSON_FLAG, QUIET_FLAG, FIELDS_FLAG, PROFILE_ARG, BASE_ARG, TIMEOUT_ARG, DRY_RUN_ARG]

GLOBAL_EXITS = "0 成功 · 2 用法 · 3 认证 / 权限 · 4 不存在 · 5 冲突 · 7 网络"


