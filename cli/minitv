def _write(args, client, method, path, body=None):
    """Send a mutating request, or print it under --dry-run."""
    if getattr(args, "dry_run", False):
        suffix = f" {json.dumps(body, ensure_ascii=False)}" if body is not None else ""
        print(f"将发送 {method} {path}{suffix}")
        return None
    return client.request(method, path, body=body)


def _require_confirm(args, target):
    want = str(target)
    got = str(getattr(args, "confirm", "") or "")
    if got != want:
        raise usage_error(
            f"--confirm 与目标不一致（目标 {want}，收到 {got or '空'}）",
            hint=f"确认无误请用 --confirm {want}",
        )


def _fetch_drama(client, drama_id):
    return client.request("GET", f"/admin/v1/dramas/{drama_id}") or {}


def cmd_drama_create(args):
    client = Client(resolve_settings(args))
    payload = None
    try:
        payload = _write(args, client, "POST", "/admin/v1/dramas", {"title": args.title})
    except CliError as exc:
        if exc.code != "title_exists" or not args.upsert:
            raise
        existing = (exc.detail or {}).get("drama_id")
        if not existing:
            raise
        payload = _fetch_drama(client, existing)
        payload["upserted"] = True
    if payload is None:
        return EXIT_OK
    output(args, payload)
    return EXIT_OK


