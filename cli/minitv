def _natural_key(name: str):
    return [int(part) if part.isdigit() else part.lower() for part in re.split(r"(\d+)", name)]


def _title_for(rule: str, number: int) -> str:
    if rule == "cn":
        return f"第 {number} 集"
    if rule == "none":
        return ""
    return f"Episode {number}"


def cmd_episode_upload_all(args):
    directory = Path(args.dir).expanduser()
    if not directory.is_dir():
        raise usage_error(f"目录不存在：{directory}")
    files = sorted(
        [item for item in directory.iterdir() if item.is_file() and item.suffix.lower() in (".mp4", ".mov")],
        key=lambda item: _natural_key(item.name),
    )
    if not files:
        raise usage_error(f"{directory} 里没有 .mp4 / .mov")
    client = Client(resolve_settings(args))
    existing = {
        row["episode_number"]: row["id"]
        for row in client.paginate(f"/admin/v1/dramas/{args.drama}/episodes", page_size=200)
    }
    results, failures = [], []
    for offset, path in enumerate(files):
        number = args.start + offset
        episode_id = existing.get(number)
        try:
            if episode_id is None:
                created = client.request(
                    "POST",
                    f"/admin/v1/dramas/{args.drama}/episodes",
                    body={"episode_number": number, "title": _title_for(args.title_rule, number)},
                )
                episode_id = created["id"]
                existing[number] = episode_id
            results.append({"number": number, "episode_id": episode_id, "file": path.name,
                            **_upload_one(args, client, episode_id, path)})
            if not _is_json(args):
                print(f"[{offset + 1}/{len(files)}] {path.name} → 第 {number} 集 · {results[-1]['status']}")
        except CliError as exc:
            failures.append({"number": number, "file": path.name, "error": exc.message})
            if not _is_json(args):
                print(f"[{offset + 1}/{len(files)}] {path.name} 失败：{exc.message}")

    published = []
    if args.publish and not failures and not getattr(args, "dry_run", False):
        for row in results:
            try:
                client.request("POST", f"/admin/v1/episodes/{row['episode_id']}/publish")
                published.append(row["episode_id"])
            except CliError as exc:
                failures.append({"episode_id": row["episode_id"], "error": exc.message})

    payload = {"uploaded": results, "published": published, "failed": failures}
    if _is_json(args):
        output(args, payload)
    else:
        print(f"汇总：成功 {len(results)} · 失败 {len(failures)} · 已发布 {len(published)}")
    return EXIT_CONFLICT if failures else EXIT_OK


