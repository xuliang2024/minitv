def config_dir() -> Path:
    return Path(os.environ.get("MINITV_CONFIG_DIR") or (Path.home() / ".config" / "minitv"))


def config_path() -> Path:
    return config_dir() / "config.json"


def credentials_path() -> Path:
    return config_dir() / "credentials"


DEFAULT_CONFIG = {
    "default_profile": "prod",
    "profiles": {
        "prod": {"base_url": "https://api.minitv.us", "sandbox_drama_id": 0},
        "local": {"base_url": "http://127.0.0.1:18110", "sandbox_drama_id": 0},
    },
}


def load_config() -> dict:
    path = config_path()
    if not path.exists():
        return json.loads(json.dumps(DEFAULT_CONFIG))
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError) as exc:
        raise CliError(
            f"配置文件无法读取：{path}（{exc}）",
            code="config_invalid",
            hint="删掉该文件后重跑 minitv config init",
        )
    data.setdefault("profiles", {})
    data.setdefault("default_profile", "prod")
    for name, prof in DEFAULT_CONFIG["profiles"].items():
        data["profiles"].setdefault(name, dict(prof))
    return data


def save_config(cfg: dict) -> None:
    directory = config_dir()
    directory.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(directory, 0o700)
    except OSError:
        pass
    config_path().write_text(json.dumps(cfg, indent=2, ensure_ascii=False) + "\n")


def load_credentials() -> dict:
    path = credentials_path()
    if not path.exists():
        return {}
    creds = {}
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        name, value = line.split("=", 1)
        creds[name.strip()] = value.strip()
    return creds


def save_credentials(creds: dict) -> None:
    directory = config_dir()
    directory.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(directory, 0o700)
    except OSError:
        pass
    path = credentials_path()
    body = "".join(f"{name}={value}\n" for name, value in sorted(creds.items()))
    fd = os.open(str(path), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as handle:
        handle.write(body)
    os.chmod(path, 0o600)


class Settings:
    def __init__(self, profile, base_url, api_key, timeout):
        self.profile = profile
        self.base_url = base_url
        self.api_key = api_key
        self.timeout = timeout


def resolve_settings(args, *, require_key=True) -> Settings:
    cfg = load_config()
    profile = getattr(args, "profile", None) or cfg.get("default_profile") or "prod"
    prof = cfg["profiles"].get(profile, {})
    base = (getattr(args, "base_url", None) or prof.get("base_url") or DEFAULT_BASE).rstrip("/")
    key = os.environ.get("MINITV_API_KEY", "").strip() or load_credentials().get(profile, "")
    timeout = getattr(args, "timeout", None) or 20
    if require_key and not key:
        raise CliError(
            f"profile '{profile}' 还没有 API Key",
            code="missing_credential",
            exit_code=EXIT_AUTH,
            hint="运行 minitv config set-key 写入，或设置环境变量 MINITV_API_KEY",
        )
    return Settings(profile, base, key, timeout)


# ---------------------------------------------------------------------------
# http
# ---------------------------------------------------------------------------


_STATUS_CODE = {
    401: ("invalid_session", EXIT_AUTH),
    403: ("scope_denied", EXIT_AUTH),
    404: ("not_found", EXIT_NOT_FOUND),
    409: ("conflict", EXIT_CONFLICT),
    422: ("validation_error", EXIT_USAGE),
    429: ("rate_limited", EXIT_CONFLICT),
}


class Client:
    def __init__(self, settings: Settings):
        self.settings = settings

    def request(self, method, path, params=None, body=None):
        url = self.settings.base_url + path
        if params:
            clean = {k: v for k, v in params.items() if v is not None}
            if clean:
                url += "?" + urllib.parse.urlencode(clean)
        data = None
        headers = {"User-Agent": UA, "Accept": "application/json"}
        if body is not None:
            data = json.dumps(body).encode()
            headers["Content-Type"] = "application/json"
        if self.settings.api_key:
            headers["Authorization"] = f"Bearer {self.settings.api_key}"

        attempts = 3 if method == "GET" else 1
        last_exc = None
        for attempt in range(attempts):
            request = urllib.request.Request(url, data=data, headers=headers, method=method)
            try:
                with urllib.request.urlopen(request, timeout=self.settings.timeout) as response:
                    raw = response.read()
                    return json.loads(raw) if raw else None
            except urllib.error.HTTPError as exc:
                payload = exc.read()
                code, exit_code = _classify(exc.code, payload)
                if exc.code in (429, 500, 502, 503, 504) and attempt + 1 < attempts:
                    time.sleep(0.5 * (attempt + 1))
                    continue
                raise CliError(
                    _message(payload) or f"HTTP {exc.code}",
                    code=code,
                    exit_code=exit_code,
                    hint=_hint(code),
                ) from exc
            except urllib.error.URLError as exc:
                last_exc = exc
                if attempt + 1 < attempts:
                    time.sleep(0.5 * (attempt + 1))
                    continue
        raise CliError(
            f"无法连接 {self.settings.base_url}：{getattr(last_exc, 'reason', last_exc)}",
            code="network_error",
            exit_code=EXIT_NETWORK,
            hint="检查网络或 --base-url；Cloudflare 会拒绝默认的 Python UA",
        )

    def paginate(self, path, params=None, page_size=100, limit=None):
        items, page = [], 1
        while True:
            query = dict(params or {})
            query.update({"page": page, "page_size": page_size})
            payload = self.request("GET", path, query) or {}
            batch = payload.get("items") or []
            items.extend(batch)
            if limit is not None and len(items) >= limit:
                return items[:limit]
            total = payload.get("total")
            if not batch or (total is not None and len(items) >= total):
                return items
            page += 1


def _payload_detail(payload):
    try:
        return json.loads(payload.decode() or "null")
    except ValueError:
        return None


def _classify(status, payload):
    detail = _payload_detail(payload)
    if isinstance(detail, dict):
        if isinstance(detail.get("detail"), dict):
            inner = detail["detail"]
            return inner.get("code") or _STATUS_CODE.get(status, ("http_error", EXIT_ERROR))[0], _exit_for(
                inner.get("code"), status
            )
        code = detail.get("code")
        if code:
            return code, _exit_for(code, status)
    return _STATUS_CODE.get(status, (f"http_{status}", EXIT_ERROR))


def _exit_for(code, status):
    if code in ("missing_credential", "invalid_key", "invalid_session", "key_expired", "key_revoked", "account_disabled", "scope_denied"):
        return EXIT_AUTH
    if code == "rate_limited":
        return EXIT_CONFLICT
    return _STATUS_CODE.get(status, ("", EXIT_ERROR))[1]


def _message(payload):
    detail = _payload_detail(payload)
    if isinstance(detail, dict):
        inner = detail.get("detail")
        if isinstance(inner, dict):
            return inner.get("message")
        if isinstance(inner, str):
            return inner
        if isinstance(inner, list) and inner:
            first = inner[0]
            if isinstance(first, dict):
                location = ".".join(str(part) for part in first.get("loc", [])[1:])
                return f"{location}: {first.get('msg')}" if location else first.get("msg")
    if isinstance(detail, str):
        return detail
    return None


def _hint(code):
    return {
        "missing_credential": "先运行 minitv config set-key，或设置 MINITV_API_KEY",
        "invalid_key": "密钥可能有误；到后台「API 密钥」页核对前缀",
        "key_expired": "运行 minitv key rotate 或让管理员重新签发",
        "key_revoked": "该密钥已被撤销，请重新签发",
        "account_disabled": "密钥绑定的账号已被禁用，联系管理员",
        "scope_denied": "当前密钥缺少该操作的 scope",
        "rate_limited": "等待一分钟再试（每 key 600 次/分钟）",
    }.get(code)


# ---------------------------------------------------------------------------
# output
# ---------------------------------------------------------------------------


def _is_json(args) -> bool:
    return bool(getattr(args, "json", False)) or not sys.stdout.isatty()


def _fields(args):
    raw = getattr(args, "fields", None)
    return [part.strip() for part in raw.split(",") if part.strip()] if raw else None


def _filter(data, fields):
    if not fields:
        return data
    if isinstance(data, list):
        return [{k: item.get(k) for k in fields if k in item} for item in data]
    if isinstance(data, dict):
        return {k: data[k] for k in fields if k in data}
    return data


def _width(text):
    return sum(2 if unicodedata.east_asian_width(ch) in "WF" else 1 for ch in text)


def _pad(text, width):
    return text + " " * max(0, width - _width(text))


def _cell(value):
    if value is None:
        return "-"
    if isinstance(value, str) and len(value) >= 19 and value[4] == "-" and value[10] == "T":
        try:
            moment = datetime.fromisoformat(value.replace("Z", "+00:00"))
            return moment.astimezone().strftime("%Y-%m-%d %H:%M")
        except ValueError:
            pass
    if isinstance(value, bool):
        return "yes" if value else "no"
    if isinstance(value, (list, tuple)):
        return ", ".join(str(item) for item in value) or "-"
    if isinstance(value, dict):
        return json.dumps(value, ensure_ascii=False)
    return str(value)


def print_table(rows, columns, footer=None):
    headers = [title for title, _ in columns]
    table = [[_cell(row.get(key)) for _, key in columns] for row in rows]
    widths = [max([_width(headers[i])] + [_width(line[i]) for line in table]) for i in range(len(columns))]
    print("  ".join(_pad(headers[i], widths[i]) for i in range(len(columns))))
    for line in table:
        print("  ".join(_pad(line[i], widths[i]) for i in range(len(columns))))
    if footer:
        print(footer)


def print_kv(pairs):
    width = max([_width(str(label)) for label, _ in pairs] + [4])
    for label, value in pairs:
        print(f"{_pad(str(label), width)}  {_cell(value)}")


def output(args, payload, *, rows=None, columns=None, footer=None, quiet_key=None):
    fields = _fields(args)
    # --quiet outranks --json: pipelines want ids, not an envelope.
    if getattr(args, "quiet", False) and rows is not None and quiet_key:
        for row in rows:
            print(row.get(quiet_key))
        return
    if _is_json(args):
        data = payload
        if fields:
            if isinstance(payload, dict) and isinstance(payload.get("items"), list):
                # Trim list rows, keep total/page intact.
                data = dict(payload)
                data["items"] = [_filter(row, fields) for row in payload["items"]]
            else:
                data = _filter(payload, fields)
        print(json.dumps({"ok": True, "data": data, "meta": {"version": VERSION}}, ensure_ascii=False))
        return
    if rows is not None and columns:
        print_table(rows, columns, footer=footer)
        return
    if isinstance(payload, dict):
        pairs = [(k, v) for k, v in payload.items() if fields is None or k in fields]
        print_kv(pairs)
    else:
        print(json.dumps(payload, ensure_ascii=False, indent=2))


