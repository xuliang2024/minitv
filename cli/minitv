def cmd_doctor(args):
    settings = resolve_settings(args, require_key=False)
    results = []

    def record(name, ok, detail, hint=None):
        results.append({"name": name, "ok": ok, "detail": detail, "hint": hint})

    health = None
    try:
        # /health needs no credential; use a throwaway client so a bad key
        # still lets us prove the network is fine.
        anonymous = Settings(settings.profile, settings.base_url, "", settings.timeout)
        health = Client(anonymous).request("GET", "/health") or {}
        record("连通", True, f"{settings.base_url} · {health.get('env', '?')}")
    except CliError as exc:
        record("连通", False, exc.message, exc.hint)
        _print_doctor(args, settings, results)
        return EXIT_NETWORK if exc.exit_code == EXIT_NETWORK else exc.exit_code

    if not settings.api_key:
        record("凭证", False, "没有配置 API Key", "运行 minitv config set-key")
        _print_doctor(args, settings, results)
        return EXIT_AUTH

    client = Client(settings)
    try:
        me, scopes, expires = _identity(client)
        record("身份", True, f"{me.get('username')}（{me.get('role')}）")
        record("权限", True, " · ".join(scopes) if scopes else "跟随账号角色")
        record("到期", True, expires or "长期")
    except CliError as exc:
        record("凭证", False, exc.message, exc.hint)
        _print_doctor(args, settings, results)
        return exc.exit_code

    record("服务端", True, f"postgres {health.get('postgres', '?')} · redis {health.get('redis', '?')}")
    warnings = _warnings(me, scopes)
    _print_doctor(args, settings, results, warnings)
    return EXIT_OK


def _print_doctor(args, settings, results, warnings=()):
    if _is_json(args):
        print(
            json.dumps(
                {
                    "ok": all(item["ok"] for item in results),
                    "data": {
                        "profile": settings.profile,
                        "base_url": settings.base_url,
                        "checks": results,
                        "warnings": list(warnings),
                    },
                },
                ensure_ascii=False,
            )
        )
        return
    for item in results:
        mark = "[ok]" if item["ok"] else "[!!]"
        print(f"{mark:<5}{item['name']:<6}{item['detail']}")
        if not item["ok"] and item.get("hint"):
            print(f"      提示：{item['hint']}")
    for note in warnings:
        print(f"[提醒] {note}")
    if all(item["ok"] for item in results):
        print("[ok] 通过" + (f"（{len(warnings)} 条提醒）" if warnings else ""))


