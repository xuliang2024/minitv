def _multipart(filename: str, content: bytes, content_type: str, field: str = "file"):
    boundary = "----minitv" + secrets.token_hex(12)
    head = (
        f"--{boundary}\r\n"
        f'Content-Disposition: form-data; name="{field}"; filename="{filename}"\r\n'
        f"Content-Type: {content_type}\r\n\r\n"
    ).encode()
    tail = f"\r\n--{boundary}--\r\n".encode()
    return head + content + tail, f"multipart/form-data; boundary={boundary}"


_COVER_MIME = {
    ".jpg": "image/jpeg",
    ".jpeg": "image/jpeg",
    ".png": "image/png",
    ".webp": "image/webp",
}
_SUBTITLE_MIME = {".vtt": "text/vtt", ".srt": "application/x-subrip"}


def _read_upload(path: Path, limit: int, allowed: dict, label: str):
    if not path.is_file():
        raise usage_error(f"文件不存在：{path}")
    ext = path.suffix.lower()
    if ext not in allowed:
        raise usage_error(f"{label} 只支持 {', '.join(sorted(allowed))}")
    data = path.read_bytes()
    if not data:
        raise usage_error(f"{path.name} 是空文件")
    if len(data) > limit:
        raise usage_error(f"{path.name} 超过 {limit // (1024 * 1024)}MB")
    return data, allowed[ext]


