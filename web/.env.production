# Production build target for minitv.us (static R2 site behind Cloudflare, no
# server-side proxy). Committed on purpose: without it `npm run build` emits
# same-origin /v1 calls that 404 on the CDN and the homepage shows
# "Could not load MiniTV". An inline shell variable still overrides this.
VITE_API_BASE=https://api.minitv.us
